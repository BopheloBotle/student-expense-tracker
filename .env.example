# Backend (Spring Boot) environment variables
# Copy to ".env" for local use (do not commit .env)

# Server
PORT=8080

# Database (Azure Database for PostgreSQL)
DB_HOST=student-expense-tracker.postgres.database.azure.com
DB_PORT=5432
DB_NAME=postgres
# Azure Postgres username format: user@server
DB_USERNAME=pgAdmin@student-expense-tracker
DB_PASSWORD=replace_me

# JWT
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRATION_MINUTES=60
JWT_ISSUER=expense-tracker

